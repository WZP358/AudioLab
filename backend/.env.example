# 复制为 backend/.env 后填写真实值；不要把真实 .env 提交到代码仓库。
DATABASE_URL=mysql+aiomysql://audiolab:CHANGE_ME@127.0.0.1:3306/audiolab
JWT_SECRET=CHANGE_ME_USE_openssl_rand_hex_32
SEPARATION_ENGINE=mss
ALLOW_TEST_ENGINES=false
MSS_FORCE_CPU=false
DEBUG_ERRORS=false
# 同源 Nginx 部署可留空；跨域部署时填写逗号分隔的完整来源。
CORS_ORIGINS=
UPLOAD_DIR=/data/AudioLab/backend/uploads
RESULTS_DIR=/data/AudioLab/backend/results
MSS_ROOT_DIR=/data/Music-Source-Separation-Training
MSS_MDX23C_CKPT=/data/models/mss/model_mdx23c_ep_168_sdr_7.0207.ckpt
MSS_DEMUCS4HT_CKPT=/data/models/mss/955717e8-8726e21a.th
MSS_BS_ROFORMER_CKPT=/data/models/mss/model_bs_roformer_ep_17_sdr_9.6568.ckpt
MSS_SCNET_CKPT=/data/models/mss/scnet_checkpoint_musdb18.ckpt
# 正式环境按学校邮件系统填写；不配置时不要把验证码流程当作正式能力。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_DELIVERY_MODE=smtp
MAIL_FROM=
